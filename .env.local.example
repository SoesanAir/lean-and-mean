# Lean & Mean — Supabase configuration (optional).
# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# The app is local-first and runs fine WITHOUT these — logging then persists to
# localStorage only. Set both to enable the cloud database layer.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) API key — safe to expose to the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
